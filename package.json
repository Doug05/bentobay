{
  "name": "bentobay",
  "productName": "BentoBay",
  "version": "0.4.0",
  "description": "One native desktop bay for all your AI tools: credits, spend, prompts, limits and a pet.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "check": "node scripts/check.js",
    "publish:private": "node scripts/push-private.js",
    "publish:public": "node scripts/go-public.js",
    "configure": "node scripts/configure.js"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.opensource.bentobay",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "BentoBay-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "BentoBay-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "BentoBay-${version}-linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "BentoBay",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/installerSidebar.bmp",
      "license": "LICENSE",
      "include": "assets/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ]
  },
  "repository": "github:Doug05/bentobay",
  "author": {
    "name": "Doug05",
    "email": "137717496+Doug05@users.noreply.github.com"
  },
  "homepage": "https://github.com/Doug05/bentobay",
  "bugs": {
    "url": "https://github.com/Doug05/bentobay/issues"
  }
}
